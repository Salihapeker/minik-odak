rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcının kendi verisi: sadece kendisi okur ve yazar.
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ortak odalar: giriş yapan (misafir dahil) herkes okur; herkes sadece kendi kaydını yazar.
    match /rooms/{room}/peers/{peer} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && peer.matches(request.auth.uid + '-.*');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /rooms/{room}/events/{ev} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.topic in ['together', 'cheer'];
    }
  }
}
